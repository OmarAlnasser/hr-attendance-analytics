# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# Required for the web app: a long random string, e.g. the output of
#   python -c "import secrets; print(secrets.token_hex(32))"
HR_SECRET_KEY=

# Optional shared password for the synthetic demo accounts created by `seed` / `demo`.
# Leave empty to generate a random one, written to instance/demo_credentials.txt.
HR_DEMO_PASSWORD=

# Set to 1 when the app is served over HTTPS (required in production).
HR_SESSION_COOKIE_SECURE=0

# Storage (defaults shown)
# PostgreSQL instead of SQLite (e.g. Supabase: use the *Session pooler* URI):
# HR_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# HR_DATABASE_PATH=instance/hr_analytics.sqlite3
# HR_REPORTS_DIR=output/reports
# HR_EXPORTS_DIR=output/powerbi
# HR_MODELS_DIR=output/models

# Time
# HR_ORG_TIMEZONE=Asia/Riyadh
# HR_DEFAULT_DEVICE_TIMEZONE=Asia/Riyadh

# Attendance rules (see docs/metrics_definitions.md)
# HR_PUNCH_DEBOUNCE_MINUTES=2
# HR_WINDOW_BEFORE_START_MIN=240
# HR_WINDOW_AFTER_END_MIN=360
# HR_LATE_MINUTES_FROM=start        # or grace_end

# Review
# HR_LOW_SCORE_THRESHOLD=3.0
# HR_SMALL_SAMPLE_EMPLOYEES=5

# Web server (python -m hr_analytics.web)
# HR_HOST=127.0.0.1
# HR_PORT=5000

# Hosting (see docs/deployment.md)
# HR_BEHIND_PROXY=1            # behind Render/Railway/nginx: trust one proxy for the client IP
# HR_DEMO_MODE=1               # public demo: one-click role buttons on the login page (synthetic data only!)
# HR_DEMO_ACCOUNTS=e0101,e0001,e0060
